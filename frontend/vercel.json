{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://portfolio-kd-five-35.vercel.app http://localhost:5173"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self \"https://portfolio-kd-five-35.vercel.app\" \"http://localhost:5173\"), camera=(), geolocation=()"
        }
      ]
    }
  ]
}
