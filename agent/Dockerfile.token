# Token server image for Cloud Run. The deploy workflow copies token_server.py, config.py,
# personas.py, requirements-token.txt (as requirements.txt) and this file (as Dockerfile)
# into one folder, so every COPY below is relative to that folder.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 TRUST_PROXY=1
WORKDIR /app
RUN useradd --create-home --uid 10001 appuser
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=appuser:appuser . .
USER appuser
# Cloud Run sets PORT (8080).
CMD ["sh", "-c", "exec uvicorn token_server:app --host 0.0.0.0 --port ${PORT:-8080}"]
