# LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vertex AI (personal project + service-account key with Vertex AI User role; never the employer key)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# Optional, off by default. Public route on the Gemini API needs a FREE-tier key (a billed key costs the same as Vertex):
#   token server: PUBLIC_BACKEND=gemini_api      agent: GEMINI_API_KEY=<key>
# /token/private always stays on Vertex.
# GEMINI_API_KEY=

# Optional: run a second worker under another name (token server must use the same value)
# AGENT_NAME=sparrow

# Public-route gate (GET /token only; defaults shown). Raise the IP limit for local testing.
# PUBLIC_IP_DAILY_LIMIT=3
# PUBLIC_GLOBAL_DAILY_LIMIT=40
# PUBLIC_MAX_TURNS=3
# PUBLIC_LIMIT_S=180
# TRUST_PROXY=1   # only when deployed behind a proxy (reads X-Forwarded-For)

# Hosted only (no local files there). Base64 of the persona text, per id (upper-case, "-" -> "_").
# PERSONA_PARTNER_B64=
# PERSONA_PARTNER_GREETING_B64=
# Token server on Cloud Run: the contents of codes.json, supplied from Secret Manager.
# CODES_JSON={"code": {"persona": "id", "name": "Name", "limit_s": 600}}
